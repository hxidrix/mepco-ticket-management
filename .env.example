# Docker Compose host-facing settings. Copy to .env only when overriding defaults.
FRONTEND_PORT=5173
BACKEND_PORT=5000
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=mepco_help_desk
MYSQL_USER=mepco_app
MYSQL_PASSWORD=replace-with-a-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
DB_SSL_MODE=disabled
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=generate-a-different-random-secret-of-at-least-32-characters
MAX_UPLOAD_BYTES=5242880
ATTACHMENT_STORAGE=local
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Local Docker uses HTTP; production HTTPS deployments must set this to true.
REFRESH_COOKIE_SECURE=false
ENABLE_API_DOCS=false
REOPEN_WINDOW_DAYS=7
