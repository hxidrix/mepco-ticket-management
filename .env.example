# Docker Compose host-facing settings. Copy to .env only when overriding defaults.
FRONTEND_PORT=5173
BACKEND_PORT=5000
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=mepco_help_desk
MYSQL_USER=mepco_app
MYSQL_PASSWORD=mepco_dev_password
MYSQL_ROOT_PASSWORD=mepco_root_dev_password
JWT_ACCESS_SECRET=docker-local-access-secret-change-before-production
JWT_REFRESH_SECRET=docker-local-refresh-secret-change-before-production
MAX_UPLOAD_BYTES=5242880
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REOPEN_WINDOW_DAYS=7
