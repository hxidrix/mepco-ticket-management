NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=debug

# XAMPP MySQL/MariaDB defaults on Windows. Change only through environment values.
# On Vercel, DATABASE_URL can replace DB_HOST through DB_NAME.
# DATABASE_URL=mysql://user:password@host:3306/mepco_help_desk
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mepco_help_desk
DB_CONNECTION_LIMIT=10
DB_SSL_MODE=disabled
# Optional base64-encoded PEM CA certificate for managed MySQL.
DB_SSL_CA_BASE64=
MYSQL_BIN_DIR=C:\xampp\mysql\bin

# Local/XAMPP and Docker use local storage. Vercel uses vercel-blob.
ATTACHMENT_STORAGE=local
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# Automatically provided when a Vercel Blob store is connected. Do not commit a token.
BLOB_READ_WRITE_TOKEN=

# Authentication values are development examples only. Replace for production.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=mepco_refresh
# Local HTTP only. Production defaults to true and must use HTTPS.
REFRESH_COOKIE_SECURE=false
ENABLE_API_DOCS=true
# local-log simulates delivery. Use webhook only with an approved SMS gateway.
SMS_DRIVER=local-log
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_SENDER_ID=MEPCO
REOPEN_WINDOW_DAYS=7
