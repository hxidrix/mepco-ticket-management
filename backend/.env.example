NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=debug

# XAMPP MySQL/MariaDB defaults on Windows. Change only through environment values.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mepco_help_desk
DB_CONNECTION_LIMIT=10
MYSQL_BIN_DIR=C:\xampp\mysql\bin

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Authentication values are development examples only. Replace for production.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=mepco_refresh
# Local HTTP only. Production defaults to true and must use HTTPS.
REFRESH_COOKIE_SECURE=false
ENABLE_API_DOCS=true
ENABLE_SELF_REGISTRATION=true
REOPEN_WINDOW_DAYS=7
