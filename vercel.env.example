# Reference only. Add these values in Vercel Project Settings -> Environment Variables.
# Never commit real credentials or copy this file to a tracked secret file.

NODE_ENV=production

# Use a managed, network-accessible MySQL 8 database. Percent-encode special
# characters in the username or password when using a connection URL.
DATABASE_URL=mysql://app_user:replace_password@mysql.example.com:3306/mepco_help_desk
DB_CONNECTION_LIMIT=5
DB_SSL_MODE=verify_identity
# Set only when the database provider supplies a custom CA. Encode the PEM as base64.
DB_SSL_CA_BASE64=

# Connect a PRIVATE Vercel Blob store to the project. Vercel automatically
# injects BLOB_STORE_ID and short-lived OIDC credentials at runtime.
ATTACHMENT_STORAGE=vercel-blob
MAX_UPLOAD_BYTES=5242880

# Generate two different random secrets of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=mepco_refresh
REFRESH_COOKIE_SECURE=true

# Use the final HTTPS application origin. Browser API calls remain same-origin.
CORS_ORIGIN=https://your-project.vercel.app
LOG_LEVEL=info
ENABLE_API_DOCS=false
REOPEN_WINDOW_DAYS=7
